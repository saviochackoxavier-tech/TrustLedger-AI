# TrustLedger AI — Environment Template (project root)
# Copy to `.env`, fill with YOUR keys, and NEVER commit the real `.env`.
# Settings load this via python-dotenv: load_dotenv(BASE_DIR / ".env")

# --- PayPal (Sandbox) ---
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
SITE_BASE_URL=http://127.0.0.1:8000

# --- Google Gemini ---
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- Django ---
SECRET_KEY=generate-a-random-64-char-string
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# --- TrustScore AI (dynamic escrow auto-release) ---
TRUSTSCORE_AUTO_RELEASE=0.95   # >= threshold: instant PayPal payout
TRUSTSCORE_REVIEW=0.70         # >= threshold: hold for human review; below: mediation
TRUSTLEDGER_RELEASE_ASYNC=1    # 1 = payout dispatched in a background thread
